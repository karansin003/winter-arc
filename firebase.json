{
  "hosting": [
    {
      "site": "arc-challenge",
      "public": ".",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md",
        "firestore.rules",
        "public/**"
      ],
      "rewrites": [
        {
          "source": "/forgot",
          "destination": "/forgot.html"
        },
        {
          "source": "/privacy",
          "destination": "/privacy.html"
        },
        {
          "source": "/terms",
          "destination": "/terms.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "winter-arc-b7f5f",

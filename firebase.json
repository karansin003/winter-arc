{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "firestore.rules",
      "public/**"
    ],
    "rewrites": [
      {
        "source": "/forgot",
        "destination": "/forgot.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

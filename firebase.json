{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "arc-challenge",
      "public": ".",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md",
        "firestore.rules",
        "public/**"
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/admin",
          "destination": "/admin.html"
        },
        {
          "source": "/winter-arc-tracker",
          "destination": "/winter-arc-tracker.html"
        },
        {
          "source": "/guide",
          "destination": "/guide.html"
        },
        {
          "source": "/about",
          "destination": "/about.html"
        },
        {
          "source": "/faq",
          "destination": "/faq.html"
        },
        {
          "source": "/contact",
          "destination": "/contact.html"
        },
        {
          "source": "/disclaimer",
          "destination": "/disclaimer.html"
        },
        {
          "source": "/forgot",
          "destination": "/forgot.html"
        },
        {
          "source": "/privacy",
          "destination": "/privacy.html"
        },
        {
          "source": "/terms",
          "destination": "/terms.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
